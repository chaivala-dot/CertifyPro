# ===========================================
# Production Environment Configuration
# ===========================================
# Copy this file to .env and fill in values
# DO NOT commit .env to version control

# ----- Application -----
APP_PORT=8000
NODE_ENV=production

# ----- Frontend -----
# URL of the frontend application (used for OAuth redirects)
FRONTEND_URL=http://localhost:5173
# For production: https://your-domain.com

# ----- Database -----
# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://certifypro:<password>@localhost:5432/certifypro
# For production: postgresql://user:password@host:port/database

# ----- Security -----
# JWT_SECRET must be at least 32 characters for adequate entropy
JWT_SECRET=<generate-256-bit-secret-minimum-32-chars>

# ----- OAuth (Google) -----
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# For production: https://your-domain.com/api/auth/google/callback

# ----- Docker Compose -----
COMPOSE_PROJECT_NAME=certifypro
